# =========================================================
# Variables de entorno para envío de correos con EmailJS
# Obtén tus credenciales gratis en https://www.emailjs.com/
# =========================================================

# ID del servicio de correo configurado en EmailJS (ej: service_xyz123)
VITE_SERVICE_ID=tu_service_id_aqui

# ID de la plantilla creada en EmailJS (ej: template_abc456)
VITE_TEMPLATE_ID=tu_template_id_aqui

# Tu Public Key / User ID de EmailJS (Account > Public Key)
VITE_USER_ID=tu_public_key_aqui
